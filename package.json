{
  "name": "space_web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript api/openapi.yaml -o src/lib/api/schema.d.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "postinstall": "node scripts/copy-map-worker.mjs",
    "predev": "node scripts/copy-map-worker.mjs",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "budget": "node scripts/check-budget.mjs",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "stub": "node tests/stub-api/server.mjs",
    "demo": "node scripts/demo.mjs",
    "test:browser": "node tests/e2e/responsive.mjs",
    "test:connected": "node tests/e2e/real-api.mjs",
    "test:maps": "node tests/e2e/maps.mjs",
    "verify:preview": "node scripts/verify-preview.mjs tests/e2e/responsive.mjs tests/e2e/cinematic.mjs tests/e2e/trust-ui.mjs",
    "test:cinematic": "node tests/e2e/cinematic.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "pmtiles": "^4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "axe-core": "^4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
