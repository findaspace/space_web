# Set these in frontend hosting secrets. No NEXT_PUBLIC_ prefix is needed.
SPACE_API_URL=https://YOUR-API-DOMAIN
SPACE_API_TIMEOUT_MS=30000
SPACE_SITE_URL=https://YOUR-FRONTEND-DOMAIN
# Must exactly match API SPACE_BFF_SECRET.
SPACE_BFF_SECRET=
SPACE_MAP_TILES_URL=https://YOUR-MEDIA-DOMAIN/maps/ghana.pmtiles
SPACE_PAYMENTS_ENABLED=false
SPACE_DEMO_MODE=false
