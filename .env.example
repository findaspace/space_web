# Copy to .env.local for development. Never prefix these with NEXT_PUBLIC_:
# that would compile them into the JavaScript every visitor downloads.
SPACE_API_URL=http://localhost:8080
SPACE_API_TIMEOUT_MS=10000

# Must match SPACE_BFF_SECRET in space_api. Generate one with:
#   openssl rand -hex 32
SPACE_BFF_SECRET=

# The public origin. Share links and canonical URLs are built from it.
SPACE_SITE_URL=http://localhost:3000

# The Ghana map tiles, a single .pmtiles file in the bucket. Leave unset to hide the map.
# SPACE_MAP_TILES_URL=http://localhost:9000/space-media/maps/ghana.pmtiles

# Booking and payment flows. Off: renters contact owners directly.
SPACE_PAYMENTS_ENABLED=false

# Local design preview only. Keep false in production.
SPACE_DEMO_MODE=false
